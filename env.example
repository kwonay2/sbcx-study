# Vercel → Project → Settings → Environment Variables 에 아래 네 가지를 넣어요.
# (로컬에서 npm run dev 할 때는 비워 두면 구글 시트 대신 .data/local-sheets.json 에 저장돼요.
#  로컬 관리자 비밀번호는 sbcx-local)

# Apps Script [배포 → 웹 앱] URL (…/exec 로 끝남)
APPS_SCRIPT_URL=

# Apps Script에서 setup 을 실행하면 실행 로그에 나오는 값
APPS_SCRIPT_SECRET=

# /admin 로그인 비밀번호 (팀원끼리만 공유)
ADMIN_PASSWORD=

# 관리자 로그인 쿠키 서명용 아무 긴 문자열 (예: 32자 이상 무작위)
SESSION_SECRET=
